const fs = require('fs');
const path = require('path');

const qadrEngine = {
    parsers: {
        // معالج المارك داون: تنظيف ذكي + توليد فهرس تلقائي
        md: (data) => {
            // 1. تنظيف الرموز التحكمية فقط مع الحفاظ على العربية والإيموجي
            let content = data.replace(/[\x00-\x08\x0B\x0C\x0E-\x1F]/g, '').replace(/\r\n/g, '\n');

            // 2. حقن الفهرس (TOC) الذكي
            // الشرط: أكثر من 15 سطر، يحتوي على عناوين فرعية، ولا يوجد فهرس مسبق
            const hasToc = content.match(/Table of Contents|فهرس المحتويات/i);
            const headings = content.match(/^##\s+.+/gm);

            if (!hasToc && headings && content.split('\n').length > 15) {
                console.log('[Qadr TOC] Generating Table of Contents...');
                const tocItems = headings.map(h => {
                    const title = h.replace('## ', '').trim();
                    const anchor = title.toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-');
                    return `  * [${title}](#${anchor})`;
                }).join('\n');

                const tocBlock = `\n### Table of Contents\n${tocItems}\n\n---\n`;
                
                // حقن الفهرس بعد أول عنوان رئيسي (#)
                content = content.replace(/^(#\s+.+\n)/, `$1${tocBlock}`);
            }
            return content;
        },

        // معالج الـ JSON: ترتيب ذكي للملاحة (حل مشكلة الـ 7 أشهر)
        json: (data, fileName) => {
            try {
                let obj = JSON.parse(data);
                if (fileName === 'docs.json' && obj.navigation) {
                    const priority = ['Start', 'AI Gateway', 'Universal Gateway'];
                    obj.navigation.sort((a, b) => {
                        const ia = priority.indexOf(a.group);
                        const ib = priority.indexOf(b.group);
                        if (ia !== -1 && ib !== -1) return ia - ib;
                        if (ia !== -1) return -1;
                        if (ib !== -1) return 1;
                        return (a.group || "").localeCompare(b.group || "");
                    });
                    console.log('[Qadr Reorder] Navigation priorities applied.');
                }
                return JSON.stringify(obj, null, 2) + '\n';
            } catch (e) {
                return data;
            }
        },

        // الحفاظ على كود اللغات البرمجية (Go, JS, Py) كما هي
        preserve: (data) => data
    },

    execute: function(filePath) {
        try {
            const ext = path.extname(filePath).toLowerCase().slice(1);
            const fileName = path.basename(filePath);
            const original = fs.readFileSync(filePath, 'utf8');
            let processed = original;

            if (['md', 'mdx'].includes(ext)) {
                processed = this.parsers.md(original);
            } else if (ext === 'json') {
                processed = this.parsers.json(original, fileName);
            } else if (['go', 'js', 'py'].includes(ext)) {
                processed = this.parsers.preserve(original);
            }

            if (processed !== original) {
                fs.writeFileSync(filePath, processed, 'utf8');
                console.log(`[Qadr] ✅ Processed: ${fileName}`);
            }
        } catch (err) {
            console.error(`[Qadr] ❌ Error: ${err.message}`);
        }
    }
};

// تشغيل المحرك على الملفات المستهدفة
// Optimized Execution for GitHub Actions
const targetFiles = [
    path.join(process.cwd(), 'README.md'),
    path.join(process.cwd(), 'docs.json')
];

targetFiles.forEach(f => {
    if (fs.existsSync(f)) {
        qadrEngine.execute(f);
    } else {
        console.warn(`[Qadr Warning] File not found: ${f}`);
    }
});

console.log('\n[DONE] Qadr Engine optimized the repository successfully.');
